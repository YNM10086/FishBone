# 小鱼骨 FishBoneX 环境变量模板
# 使用：复制本文件为 .env 并填入真实值（.env 已被 .gitignore 排除，不会上传）
# 未配置时的行为：
#   - DeepSeek API：对话页“AI 模型配置”中仍可运行时填写，并持久化到本地 ai_config.json
#   - 天地图：地理编码/POI 检索会提示“未配置天地图 Key”

# ── DeepSeek API ──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# ── 天地图（地理编码 / POI 检索 / 瓦片代理）──
TIANDITU_KEY=

# ── Ollama 本地模型（可选，内置默认值）──
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:8b
